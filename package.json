{
  "name": "sigk-pdf",
  "productName": "SigK PDF",
  "version": "0.1.0",
  "description": "PDF の閲覧・ページ操作・結合・分割・変換・注釈を1つの画面で行う Windows デスクトップアプリ",
  "author": "kuwagata-137",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "notices": "node scripts/notices.js",
    "fixtures": "node test/fixtures/build.js",
    "pretest": "node test/fixtures/build.js",
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "build": {
    "appId": "com.kuwagata.sigkpdf",
    "productName": "SigK PDF",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "security-policy.js",
      "settings.js",
      "errorlog.js",
      "file-io.js",
      "recent-documents.js",
      "pdf-write.js",
      "launch-args.js",
      "task-runner.js",
      "worker/**",
      "index.html",
      "renderer/**",
      "assets/**",
      "vendor/**",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SigK PDF"
    }
  }
}
